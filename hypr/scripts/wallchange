#!/usr/bin/env bash

WALL_DIR="$HOME/Pictures/Wallpapers"
STATE_FILE="$HOME/.cache/swww-wall-state"
VERBOSE=false
TRANSITION="grow"
DURATION=1

TRANSITIONS=(
  "any"
  "simple"
  "grow"
  "outer"
  "center"
  "left"
  "right"
  "top"
  "bottom"
  "wipe"
  "fade"
  "wave"
  "random"
)

log() { $VERBOSE && echo "[+] $*"; }

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]
Options:
  -d, --dir DIR            Wallpaper directory (default: ~/Pictures/Wallpapers)
  -r, --random             Select random wallpaper
  -n, --next               Go to next wallpaper in sequence
  -p, --previous           Go to previous wallpaper in sequence
  -t, --transition TYPE    Set transition type (or 'random' for random transition)
  -T, --time SECONDS       Transition duration in seconds (default: 1)
  -v, --verbose            Enable verbose logging
  -h, --help               Show this help message

Available transitions:
  ${TRANSITIONS[*]}
EOF
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--dir) WALL_DIR="$2"; shift 2 ;;
    -r|--random) MODE="random"; shift ;;
    -n|--next) MODE="next"; shift ;;
    -p|--previous) MODE="previous"; shift ;;
    -t|--transition) TRANSITION="$2"; shift 2 ;;
    -T|--time) DURATION="$2"; shift 2 ;;
    -v|--verbose) VERBOSE=true; shift ;;
    -h|--help) usage ;;
    *) echo "Unknown option: $1"; usage ;;
  esac
done

if ! pgrep -x "swww-daemon" > /dev/null; then
  log "Starting swww-daemon..."
  swww-daemon &
  sleep 1
fi

mapfile -t WALLS < <(find "$WALL_DIR" -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) | sort)

if [[ ${#WALLS[@]} -eq 0 ]]; then
  echo "No wallpapers found in $WALL_DIR"
  exit 1
fi

index=0
if [[ -f "$STATE_FILE" ]]; then
  index=$(<"$STATE_FILE")
fi

case "$MODE" in
  random)
    index=$(( RANDOM % ${#WALLS[@]} ))
    ;;
  next)
    index=$(( (index + 1) % ${#WALLS[@]} ))
    ;;
  previous)
    index=$(( (index - 1 + ${#WALLS[@]}) % ${#WALLS[@]} ))
    ;;
  *)
    index=$(( RANDOM % ${#WALLS[@]} ))
    ;;
esac

echo "$index" > "$STATE_FILE"
WALL="${WALLS[$index]}"

if [[ "$TRANSITION" == "random" ]]; then
  TRANSITION=${TRANSITIONS[$(( RANDOM % ${#TRANSITIONS[@]} ))]}
fi

log "Setting wallpaper: $WALL"
log "Transition: $TRANSITION"
log "Duration: ${DURATION}s"

swww img "$WALL" --transition-type "$TRANSITION" --transition-duration "$DURATION"
