* {
    font: "JetBrainsMono Nerd Font 10";
    icon-theme: "Tela-circle-blue-dark";
    background: rgba(28, 28, 28, 0.95);
    foreground: #ffffff;
    selected-background: rgba(255, 255, 255, 0.15);
    selected-foreground: #ffffff;
    border-radius: 12px;
}

configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    alternate-row-colors: false;
}

window {
    width: 350px;
    height: 378px;
    transparency: "real";
    fullscreen: false;
    enabled: true;
    cursor: "default";
    spacing: 0px;
    border-radius: @border-radius;
    background-color: @background;
    // border: 1px solid rgba(255, 255, 255, 0.1);
}

mainbox {
    enabled: true;
    spacing: 0px;
    padding: 15px;
    orientation: vertical;
    children: ["inputbar", "listbox"];
    background-color: transparent;
}

inputbar {
    enabled: true;
    padding: 8px 12px;
    spacing: 10px;
    margin: 0px 0px 15px 0px;
    background-color: rgba(255, 255, 255, 0.1);
    text-color: @foreground;
    border-radius: 8px;
    children: ["entry"];
}

entry {
    enabled: true;
    padding: 4px;
    text-color: inherit;
    cursor: text;
    placeholder: "Search";
    placeholder-color: rgba(255, 255, 255, 0.5);
    background-color: transparent;
    font: "SF Pro Text 13";
}

listbox {
    padding: 0px;
    spacing: 0px;
    orientation: vertical;
    children: ["listview"];
    background-color: transparent;
}

listview {
    padding: 0px;
    spacing: 4px;
    enabled: true;
    columns: 1;
    rows: 6;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    cursor: "default";
    background-color: transparent;
    border-radius: @border-radius;
}

element {
    orientation: horizontal;
    enabled: true;
    spacing: 12px;
    padding: 8px 12px;
    cursor: pointer;
    background-color: transparent;
    color: @foreground;
    border-radius: 6px;
}

element selected.normal {
    background-color: @selected-background;
    text-color: @selected-foreground;
}

element-icon {
    size: 28px;
    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.0;
    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
    font: "SF Pro Text 12";
}

error-message {
    padding: 15px;
    text-color: #ff6b6b;
    background-color: @background;
    border-radius: @border-radius;
    children: ["textbox"];
}

textbox {
    text-color: inherit;
    background-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}
